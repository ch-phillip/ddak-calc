---
const { title = '딱계산 | 생활 계산을 빠르고 간단하게', description = '퍼센트, 할인율, 날짜, 시급, 부가세, 평수까지. 한국 생활에 필요한 계산을 무료로 간편하게 해보세요.', path = '/', type = 'website' } = Astro.props;
const url = `https://ddak-calc.pages.dev${path}`;
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#f8faf7"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={url}/><meta property="og:type" content={type}/><meta property="og:locale" content="ko_KR"/><meta property="og:site_name" content="딱계산"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><slot name="head"/><style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans','Noto Sans KR',sans-serif;color:#18231f;background:#f8faf7;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0}.calc-input{width:100%;height:54px;border:1px solid #e6ebe7;border-radius:14px;background:#fbfcfb;padding:0 48px 0 16px;color:#18231f;font-size:16px;font-weight:600;outline:none;transition:.2s}.calc-input:focus{border-color:#68a48a;box-shadow:0 0 0 4px rgba(23,107,80,.09)}.calc-input::placeholder{color:#a5afa9;font-weight:400}input[type=date]{padding-right:14px}
</style></head><body><slot/></body></html>
