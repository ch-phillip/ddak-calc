---
import Base from '../../layouts/Base.astro'; import Shell from '../../components/Shell.astro'; import Calculator from '../../components/Calculator'; import type { Kind } from '../../components/Calculator';
export function getStaticPaths(){return ['percent','discount','date','hourly','vat','area'].map(kind=>({params:{kind}}))}
const data:Record<string,{title:string;desc:string;intro:string;method:string;example:string;faqs:[string,string][]}>={
 percent:{title:'퍼센트 계산기',desc:'비율 계산, 증가율과 감소율을 간단히 계산해 보세요. 기준값과 비율을 입력하면 결과를 바로 확인할 수 있습니다.',intro:'전체 중 일부가 몇 퍼센트인지, 또는 값이 얼마나 늘거나 줄었는지 확인할 때 쓰는 계산기예요.',method:'비율 계산은 기준값에 비율을 곱한 뒤 100으로 나눕니다. 변화율은 (나중 값 − 이전 값) ÷ |이전 값| × 100으로 계산합니다. 기준값이 0이면 변화율은 정의되지 않습니다.',example:'10,000원의 15%는 1,500원입니다. 10,000원이 12,000원이 되었다면 20% 증가한 것이고, 8,000원이 되었다면 20% 감소한 것입니다.',faqs:[['퍼센트는 어떻게 계산하나요?','기준값에 퍼센트를 곱한 뒤 100으로 나누면 됩니다. 예를 들어 200의 10%는 200 × 10 ÷ 100 = 20입니다.'],['변화율에서 이전 값이 0이면 어떻게 하나요?','0을 기준으로 한 증가율은 나눗셈이 불가능하므로 수학적으로 정의되지 않습니다.'],['감소율은 음수로 표시되나요?','비교할 값을 기준값보다 작게 입력하면 변화율에 음수가 표시되어 감소를 나타냅니다.']]},
 discount:{title:'할인율 계산기',desc:'할인 전 가격과 할인율로 최종 가격과 절약 금액을 계산하세요. 쇼핑 전 간편하게 확인할 수 있습니다.',intro:'가격표의 할인율이 실제로 얼마를 아끼는지, 결제 금액은 얼마인지 빠르게 계산해요.',method:'절약 금액은 할인 전 가격 × 할인율 ÷ 100입니다. 할인 후 가격은 할인 전 가격에서 절약 금액을 뺀 값입니다. 결과는 소수 둘째 자리까지 반올림합니다.',example:'30,000원 상품을 20% 할인하면 6,000원을 아끼고 최종 가격은 24,000원입니다.',faqs:[['쿠폰과 할인을 함께 적용할 수 있나요?','이 계산기는 한 가지 할인율을 계산합니다. 중복 할인은 첫 할인 후 금액을 새 할인 전 가격으로 입력해 계산하세요.'],['할인율 100%는 무엇인가요?','가격 전체가 할인되어 결제할 금액이 0원이 됩니다.'],['할인 가격이 실제 결제액과 다를 수 있나요?','배송비, 쿠폰, 포인트, 결제 조건은 포함되지 않으므로 결제 페이지에서 최종 금액을 확인하세요.']]},
 date:{title:'날짜 계산기',desc:'두 날짜 사이의 일수와 날짜 더하기·빼기를 계산하세요. D-day와 일정 확인에 유용합니다.',intro:'여행까지 남은 날, 계약 기간, 기념일 날짜처럼 날짜 사이의 간격을 확인할 수 있어요.',method:'날짜 차이는 시간대를 보정해 달력 날짜끼리 계산하며 시작일은 포함하지 않습니다. 날짜 더하기·빼기는 입력 날짜에 지정한 일수를 적용합니다.',example:'2025년 5월 1일부터 5월 10일까지는 9일 차이입니다. 5월 1일에서 30일 뒤는 5월 31일입니다.',faqs:[['D-day처럼 당일을 포함해서 세고 싶어요.','기본 차이는 날짜 사이의 간격입니다. 당일을 포함하는 일정 계산이라면 결과에 하루를 더해 세면 됩니다.'],['윤년 날짜도 맞게 계산하나요?','네. 달력의 실제 날짜를 기준으로 계산하여 윤년의 2월 29일도 반영합니다.'],['과거 날짜를 입력해도 되나요?','가능합니다. 종료 날짜가 더 이르면 차이와 함께 순서 안내가 표시됩니다.']]},
 hourly:{title:'시급 계산기',desc:'시급과 근무 시간으로 예상 급여를 계산하세요. 세금 및 주휴수당 등 각종 수당은 별도입니다.',intro:'시급과 일한 시간을 곱해 세전 기준의 단순 예상 급여를 계산해요.',method:'예상 급여는 입력한 시급 × 근무 시간입니다. 세금, 공제액, 주휴수당, 야간·연장·휴일 수당은 계산에 포함되지 않습니다.',example:'시급 10,000원으로 8시간 일했다면 단순 계산 급여는 80,000원입니다. 실제 지급액은 근로 조건에 따라 달라질 수 있습니다.',faqs:[['세금이 빠진 실수령액인가요?','아닙니다. 세금 및 공제 전 단순 계산이며 실제 급여명세와 차이가 날 수 있습니다.'],['주휴수당도 포함되나요?','주휴수당과 기타 수당은 반영하지 않습니다. 해당 조건은 사업장과 근로 계약을 확인해 주세요.'],['근무 시간을 소수로 입력할 수 있나요?','네. 7.5시간처럼 소수 시간으로 입력할 수 있습니다.']]},
 vat:{title:'부가세 계산기',desc:'공급가액에서 부가세와 합계 금액을 구하거나, 부가세 포함 금액에서 공급가액을 역산하세요.',intro:'부가세 별도 금액과 포함 금액 사이를 간편하게 변환할 수 있어요. 기본 세율은 10%입니다.',method:'별도 금액은 공급가액 × 세율로 부가세를 구하고, 공급가액에 더해 합계를 구합니다. 포함 금액은 합계 ÷ (1 + 세율)로 공급가액을 역산합니다.',example:'공급가액 100,000원에 10%를 적용하면 부가세 10,000원, 합계 110,000원입니다. 포함 금액 110,000원은 공급가액 100,000원과 부가세 10,000원으로 나뉩니다.',faqs:[['기본 세율은 얼마인가요?','기본 입력값은 10%입니다. 거래에 적용되는 세율은 품목과 거래 유형에 따라 확인이 필요합니다.'],['포함 금액 역산에서 1원 오차가 날 수 있나요?','원 단위 반올림과 공급가액·세액 분리 방식 때문에 실제 세금계산서와 차이가 날 수 있습니다.'],['모든 거래의 세율이 10%인가요?','아닙니다. 과세 여부나 적용 세율은 거래별로 다를 수 있으니 공식 안내나 전문가에게 확인하세요.']]},
 area:{title:'평수 계산기',desc:'제곱미터(㎡)와 평을 양방향으로 변환하세요. 부동산 면적을 빠르게 가늠할 수 있습니다.',intro:'제곱미터와 평을 서로 바꿔 보며 공간의 크기를 익숙한 단위로 비교해요.',method:'1평은 약 3.305785㎡입니다. 제곱미터에서 평으로 바꿀 때는 3.305785로 나누고, 평에서 제곱미터로 바꿀 때는 곱합니다.',example:'전용면적 84㎡는 약 25.41평입니다. 반대로 30평은 약 99.17㎡입니다.',faqs:[['계산에 사용한 환산 기준은 무엇인가요?','1평 = 400/121㎡(약 3.305785㎡) 기준으로 소수 둘째 자리까지 표시합니다.'],['아파트의 공급면적과 전용면적 중 어느 값인가요?','원하는 기준의 면적을 입력하세요. 이 계산기는 면적 기준을 따로 판단하지 않으며 단위만 변환합니다.'],['결과가 부동산 광고와 다를 수 있나요?','표시 반올림과 면적 기준 차이 때문에 달라 보일 수 있습니다. 계약 면적은 공식 서류를 확인하세요.']]}
};
const kind=Astro.params.kind as Kind; const item=data[kind]; const path=`/calculators/${kind}/`;
---
<Base title={`${item.title} | 딱계산`} description={item.desc} path={path}><slot name="head"><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:`딱계산 ${item.title}`,url:new URL(path, Astro.site).toString(),description:item.desc,applicationCategory:'UtilitiesApplication',operatingSystem:'Any',offers:{'@type':'Offer',price:'0',priceCurrency:'KRW'}})} /></slot><Shell active="계산기"><main><div class="mx-auto max-w-6xl px-5 py-10 sm:py-14"><div class="mb-7"><a href="/" class="text-sm font-semibold text-muted hover:text-forest">홈</a><span class="mx-2 text-muted">/</span><span class="text-sm font-semibold text-forest">{item.title}</span><h1 class="mt-5 text-3xl font-extrabold tracking-tight sm:text-4xl">{item.title}</h1><p class="mt-3 max-w-2xl leading-7 text-muted">{item.intro}</p></div><Calculator client:load kind={kind}/><div class="mt-12 grid gap-6 lg:grid-cols-[1fr_.85fr]"><article class="rounded-3xl border border-black/5 bg-white p-6 sm:p-8"><p class="text-xs font-bold tracking-wider text-forest">HOW IT WORKS</p><h2 class="mt-2 text-xl font-extrabold">계산 방법</h2><p class="mt-4 leading-7 text-muted">{item.method}</p><div class="mt-6 rounded-2xl bg-mint p-5"><h3 class="font-bold">계산 예시</h3><p class="mt-2 text-sm leading-6 text-muted">{item.example}</p></div></article><aside class="rounded-3xl border border-black/5 bg-white p-6 sm:p-8"><p class="text-xs font-bold tracking-wider text-forest">QUICK TIP</p><h2 class="mt-2 text-xl font-extrabold">이렇게 써보세요</h2><p class="mt-4 text-sm leading-6 text-muted">값을 바꾸면 결과가 바로 갱신됩니다. 결과 복사 버튼으로 계산 내용을 저장하거나 공유할 수 있어요.</p><a href="/#calculators" class="mt-5 inline-flex text-sm font-bold text-forest">다른 계산기도 보기 →</a></aside></div><section class="mt-10 rounded-3xl border border-black/5 bg-white p-6 sm:p-8"><p class="text-xs font-bold tracking-wider text-forest">FAQ</p><h2 class="mt-2 text-xl font-extrabold">자주 묻는 질문</h2><div class="mt-5 divide-y divide-black/5">{item.faqs.map(([q,a])=><details class="group py-4"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold"><span>{q}</span><span class="text-xl text-forest transition group-open:rotate-45">＋</span></summary><p class="mt-3 pr-8 text-sm leading-6 text-muted">{a}</p></details>)}</div></section></div></main></Shell></Base>
